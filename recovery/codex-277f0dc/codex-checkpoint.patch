--- /dev/null
+++ b/src/lib/analytics.ts
@@ -0,0 +1,46 @@
+import "server-only";
+import { db } from "@/lib/db";
+
+const DAY = 86_400_000;
+const validDate = (x: string) => /^\d{4}-\d{2}-\d{2}$/.test(x) && !Number.isNaN(Date.parse(`${x}T00:00:00Z`));
+export function analyticsRange(from?: string, to?: string) {
+  const today = new Date().toISOString().slice(0, 10);
+  const end = validDate(to || "") ? to! : today;
+  const startFallback = new Date(Date.parse(`${end}T00:00:00Z`) - 29 * DAY).toISOString().slice(0, 10);
+  const start = validDate(from || "") ? from! : startFallback;
+  const after = new Date(Date.parse(`${end}T00:00:00Z`) + DAY).toISOString().slice(0, 10);
+  return { from: start <= end ? start : startFallback, to: end, start: `${start <= end ? start : startFallback} 00:00:00`, end: `${after} 00:00:00` };
+}
+
+export function salesAnalytics(range: { start: string; end: string }) {
+  const d = db();
+  const orders = d.prepare(`SELECT COUNT(*) total,
+    SUM(CASE WHEN payment_status='paid' AND fulfilment_status!='cancelled' THEN 1 ELSE 0 END) paid,
+    SUM(CASE WHEN payment_status='pending_payment' AND fulfilment_status!='cancelled' THEN 1 ELSE 0 END) pending,
+    SUM(CASE WHEN payment_status='awaiting_verification' AND fulfilment_status!='cancelled' THEN 1 ELSE 0 END) awaiting,
+    SUM(CASE WHEN fulfilment_status='cancelled' THEN 1 ELSE 0 END) cancelled,
+    SUM(CASE WHEN fulfilment_status='delivered' THEN 1 ELSE 0 END) completed,
+    COALESCE(SUM(CASE WHEN payment_status='paid' AND fulfilment_status!='cancelled' THEN subtotal ELSE 0 END),0) revenue,
+    COALESCE(SUM(CASE WHEN delivery_payment_status='paid' AND fulfilment_status!='cancelled' THEN delivery_fee ELSE 0 END),0) delivery_collected
+    FROM orders WHERE created_at>=? AND created_at<?`).get(range.start, range.end);
+  const paid = Number(orders?.paid || 0);
+  const revenue = Number(orders?.revenue || 0);
+  const products = d.prepare(`SELECT oi.name,oi.variant_label,SUM(oi.qty) quantity,SUM(oi.line_total-oi.discount_amount) gross
+    FROM order_items oi JOIN orders o ON o.id=oi.order_id
+    WHERE o.created_at>=? AND o.created_at<? AND o.payment_status='paid' AND o.fulfilment_status!='cancelled'
+    GROUP BY oi.product_id,oi.variant_label,oi.name ORDER BY gross DESC LIMIT 100`).all(range.start, range.end);
+  const categories = d.prepare(`SELECT COALESCE(c.name,'Uncategorised') name,COUNT(DISTINCT o.id) orders,
+    SUM(oi.line_total-oi.discount_amount) gross FROM order_items oi JOIN orders o ON o.id=oi.order_id
+    LEFT JOIN products p ON p.id=oi.product_id LEFT JOIN categories c ON c.slug=p.category
+    WHERE o.created_at>=? AND o.created_at<? AND o.payment_status='paid' AND o.fulfilment_status!='cancelled'
+    GROUP BY c.slug,c.name ORDER BY gross DESC`).all(range.start, range.end);
+  const states = d.prepare(`SELECT state,COUNT(*) orders,SUM(subtotal) revenue,
+    SUM(CASE WHEN delivery_payment_status='paid' THEN COALESCE(delivery_fee,0) ELSE 0 END) delivery_collected
+    FROM orders WHERE created_at>=? AND created_at<? AND payment_status='paid' AND fulfilment_status!='cancelled'
+    GROUP BY state ORDER BY revenue DESC`).all(range.start, range.end);
+  return { summary: {
+    total: Number(orders?.total || 0), paid, pending: Number(orders?.pending || 0), awaiting: Number(orders?.awaiting || 0),
+    cancelled: Number(orders?.cancelled || 0), completed: Number(orders?.completed || 0), revenue,
+    delivery_collected: Number(orders?.delivery_collected || 0), avgOrderValue: paid ? Math.round(revenue / paid) : 0,
+  }, products, categories, states };
+}
diff --git a/src/lib/coupons.ts b/src/lib/coupons.ts
new file mode 100644
index 0000000..0035012
--- /dev/null
+++ b/src/lib/coupons.ts
@@ -0,0 +1,45 @@
+import "server-only";
+import { db } from "@/lib/db";
+import type { DB } from "@/lib/db";
+
+export type CouponLine = { productId: number; variantId?: number; lineTotal: number };
+export type CouponResult = { ok: true; code: string; discountAmount: number; eligibleSubtotal: number; eligibleVariantIds: number[] } | { ok: false; error: string };
+const parseIds = (value: unknown): number[] => { try { const v = JSON.parse(String(value || "[]")); return Array.isArray(v) ? v.map(Number).filter((n) => Number.isSafeInteger(n) && n > 0) : []; } catch { return []; } };
+const parseSlugs = (value: unknown): string[] => { try { const v = JSON.parse(String(value || "[]")); return Array.isArray(v) ? v.map(String).filter((x) => /^[a-z0-9-]{1,70}$/.test(x)) : []; } catch { return []; } };
+
+export function validateCoupon(codeInput: unknown, lines: CouponLine[], customerKey = "", connection: DB = db(), now = new Date()): CouponResult {
+  const code = String(codeInput || "").trim().toUpperCase().slice(0, 40);
+  if (!code) return { ok: false, error: "Enter a coupon code." };
+  const coupon = connection.prepare("SELECT * FROM coupons WHERE code=?").get(code);
+  if (!coupon || Number(coupon.active) !== 1) return { ok: false, error: "That coupon is not available." };
+  const today = now.toISOString().slice(0, 10);
+  const startsAt = String(coupon.starts_at || "");
+  const expiresAt = String(coupon.expires_at || "");
+  if (startsAt && today < startsAt) return { ok: false, error: "That coupon is not active yet." };
+  if (expiresAt && today > expiresAt) return { ok: false, error: "That coupon has expired." };
+  const used = Number(connection.prepare("SELECT COUNT(*) n FROM coupon_redemptions WHERE coupon_id=?").get(coupon.id)?.n || 0);
+  if (coupon.usage_limit != null && used >= Number(coupon.usage_limit)) return { ok: false, error: "That coupon has reached its usage limit." };
+  if (customerKey && Number(coupon.customer_limit) > 0) {
+    const customerUsed = Number(connection.prepare("SELECT COUNT(*) n FROM coupon_redemptions WHERE coupon_id=? AND customer_key=?").get(coupon.id, customerKey)?.n || 0);
+    if (customerUsed >= Number(coupon.customer_limit)) return { ok: false, error: "You have already used that coupon the allowed number of times." };
+  }
+  const productIds = parseIds(coupon.product_ids);
+  const categorySlugs = parseSlugs(coupon.category_slugs);
+  let eligible = lines;
+  if (productIds.length || categorySlugs.length) {
+    eligible = lines.filter((line) => {
+      if (productIds.includes(line.productId)) return true;
+      if (categorySlugs.length) return categorySlugs.includes(String(connection.prepare("SELECT category FROM products WHERE id=?").get(line.productId)?.category || ""));
+      return false;
+    });
+  }
+  const eligibleSubtotal = eligible.reduce((sum, line) => sum + Math.max(0, Math.floor(line.lineTotal)), 0);
+  if (!eligibleSubtotal) return { ok: false, error: "This coupon does not apply to the items in your cart." };
+  const orderTotal = lines.reduce((sum, line) => sum + Math.max(0, Math.floor(line.lineTotal)), 0);
+  if (orderTotal < Number(coupon.minimum_order || 0)) return { ok: false, error: `Your product subtotal must be at least ₦${Number(coupon.minimum_order).toLocaleString("en-NG")} to use this coupon.` };
+  const value = Number(coupon.discount_value);
+  const discountAmount = coupon.discount_type === "percent" ? Math.floor(eligibleSubtotal * Math.min(100, value) / 100) : Math.min(eligibleSubtotal, value);
+  if (discountAmount < 1) return { ok: false, error: "This coupon does not discount the items in your cart." };
+  if (discountAmount >= orderTotal) return { ok: false, error: "The coupon cannot reduce the product payment to zero. Use a smaller discount." };
+  return { ok: true, code, discountAmount, eligibleSubtotal, eligibleVariantIds: eligible.map((line) => Number(line.variantId || 0)).filter((id) => id > 0) };
+}
