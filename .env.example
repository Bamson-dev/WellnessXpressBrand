# WellnessXpressBrand environment variables.
# Names and purpose only — NEVER put real secrets in this file.
# In production these are set in Coolify (build-time args where marked, runtime env otherwise).
# Secrets (anything marked SECRET) must never be committed, logged, or exposed to the browser.

# ---- Public / site ----
# Public site URL (canonical, no trailing slash)
NEXT_PUBLIC_SITE_URL=https://wellnessxpressbrand.com

# WhatsApp business number in international format, digits only (example shape: 234XXXXXXXXXX).
# Leave empty to keep the WhatsApp buttons disabled.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public contact email shown on the contact page. Leave empty to hide it.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional analytics. Leave empty to disable.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# GA4 measurement id read at runtime (preferred over NEXT_PUBLIC_GA_ID when both are set).
GA_MEASUREMENT_ID=
# GA4 property id, used only by reporting scripts (scripts/seo-weekly-report.mjs).
GA4_PROPERTY_ID=

# Payments stay disabled until a provider is connected. Do not set to true without provider credentials in code.
PAYMENTS_ENABLED=false

# Directory for the SQLite database, receipts, media and product images. MUST be a persistent
# Coolify volume (Dockerfile creates /data). Orders and receipts are lost on redeploy if this is not persisted.
DATA_DIR=/data

# Show clearly labelled sample products (status "sample") for local testing only. Never true in production.
SHOW_SAMPLE_PRODUCTS=false

# Coming Soon mode: every public URL shows /coming-soon. Set to false and redeploy to restore the storefront.
COMING_SOON=true

# Set this same stable key at Coolify build time and runtime for Server Actions.
# Must be a base64 key that decodes to 16, 24 or 32 bytes, and must not change between deploys.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ---- Admin (SECRET, runtime, required) ----
# Owner sign-in email for /admin.
ADMIN_EMAIL=
# Owner sign-in password for /admin. SECRET.
ADMIN_PASSWORD=
# Signing secret for admin session cookies, 32+ random characters. SECRET.
# If unset, the signing key is derived from ADMIN_PASSWORD (works, but set this in production).
ADMIN_SESSION_SECRET=

# ---- Meta tracking ----
# Store browser Pixel id (build-time, public). Optional: the store Pixel loads only when set.
# Do NOT set this to the funnel Pixel id below unless you intend store traffic in the funnel dataset.
NEXT_PUBLIC_META_PIXEL_ID=
# Store Conversions API token for the store Pixel above. SECRET, runtime. Store Purchase is sent
# server-side only after an admin verifies payment.
META_STORE_CAPI_TOKEN=
# Funnel (WhatsApp landing) Pixel id. Defaults in code to 1290890196474517 (Edith Pixel 1) when unset.
META_PIXEL_ID_WHATSAPP=
# Funnel Conversions API token for the funnel Pixel. SECRET, runtime. Required for funnel Lead/Purchase
# and for payment-confirmation Purchases; without it those events report "not_configured".
META_CAPI_ACCESS_TOKEN_WHATSAPP=
# Telegram funnel Pixel id and token, used by the /api/meta-capi relay for non-WhatsApp landing paths.
# META_CAPI_ACCESS_TOKEN is SECRET, runtime.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Meta Graph API version. Defaults to v21.0 when unset.
META_GRAPH_VERSION=
# TEST ONLY: when set, Purchase events (funnel + payment confirmations) go to Meta Test Events and are
# recorded as "sent_test" — never as production purchases. Must be EMPTY in normal production running.
META_PURCHASE_TEST_EVENT_CODE=
# TEST ONLY: when set, browser-relayed events via /api/meta-capi go to Meta Test Events. Empty in production.
META_CAPI_TEST_EVENT_CODE=

# ---- TikTok tracking ----
# TikTok Events API pixel code (server-side Purchase for funnel orders).
TIKTOK_PIXEL_CODE=
# TikTok Events API access token. SECRET, runtime. Without code+token, TikTok Purchase is "not_configured".
TIKTOK_EVENTS_ACCESS_TOKEN=
# TEST ONLY: TikTok test event code. When set, TikTok events are recorded as "sent_test". Empty in production.
TIKTOK_TEST_EVENT_CODE=
# TikTok browser Pixel code (public). Loads the browser pixel (PageView) only when set.
NEXT_PUBLIC_TIKTOK_PIXEL_CODE=

# ---- SEO / integrations (optional) ----
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Google Search Console / Analytics service credentials, used only by SEO scripts. SECRET.
GOOGLE_SA_JSON=
GOOGLE_ACCESS_TOKEN=
