# Public site URL (canonical, no trailing slash)
NEXT_PUBLIC_SITE_URL=https://wellnessxpressbrand.com

# WhatsApp business number in international format, digits only (example shape: 234XXXXXXXXXX).
# Leave empty to keep the WhatsApp buttons disabled.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public contact email shown on the contact page. Leave empty to hide it.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional analytics. Leave empty to disable.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Payments stay disabled until a provider is connected. Do not set to true without provider credentials in code.
PAYMENTS_ENABLED=false

# Directory for persisted newsletter, contact and order-request files. Mount a persistent volume here.
DATA_DIR=/data

# Show clearly labelled sample products (status "sample") for local testing only. Never true in production.
SHOW_SAMPLE_PRODUCTS=false
